    "start": "node -e \"delete process.env.__NEXT_PRIVATE_STANDALONE_CONFIG; const r=require('child_process').spawnSync('npx',['next','start'],{stdio:'inherit',shell:true,env:process.env}); process.exit(r.status ?? 1);\"",
    "lint": "node -e \"delete process.env.__NEXT_PRIVATE_STANDALONE_CONFIG; const r=require('child_process').spawnSync('npx',['next','lint'],{stdio:'inherit',shell:true,env:process.env}); process.exit(r.status ?? 1);\""
  },
